#-------------------------
# Operating Specific Junk Files
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride

# OS X Thumbnails
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

#-------------------------
# Environment Files
#-------------------------
# These should never be under version control,
# as it poses a security risk.
.env
.vagrant
Vagrantfile

#-------------------------
# Temporary Files
#-------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

php_errors.log

#-------------------------
# User Guide Temp Files
#-------------------------
/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

#-------------------------
# Test Files
#-------------------------
/tests/coverage*

# Don't save phpunit under version control.
/phpunit

#-------------------------
# Composer
#-------------------------
# Anchored to the project root on purpose. An unanchored `vendor/` also
# matches public/assets/vendor/, which silently excluded the front-end
# libraries (select2, sweetalert2) from version control.
/vendor/

#-------------------------
# Runtime data and local test artifacts
#-------------------------
# Staff-uploaded institute logo/letterhead. Runtime data, not source --
# InstituteDetailsService::storeUploadedFile() recreates the directory on
# demand, so ignoring it cannot break a fresh deployment.
/public/uploads/

# curl cookie jars left behind by manual/scripted auth testing. These hold
# live ci_session and CSRF values, so they must never reach a commit.
# Patterns kept broad on purpose: the previous list named /admin.txt
# specifically, which meant the next jar saved under any other name would
# have been committable.
/admin.txt
cookies*.txt
*.cookies
jar*.txt
*.cookiejar

# Local .env backups. .env itself is ignored above, but a copy taken before
# an edit carries the same database password and encryption key.
.env.bak*
.env.*.bak

#-------------------------
# IDE / Development Files
#-------------------------

# Modules Testing
_modules/*

# phpenv local config
.php-version

# Jetbrains editors (PHPStorm, etc)
.idea/
*.iml

# NetBeans
/nbproject/
/build/
/nbbuild/
/dist/
/nbdist/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel
/api/

# Visual Studio Code
.vscode/

/results/
/phpunit.xml
/writable/backups/*
!/writable/backups/index.html

#-------------------------
# Security audit documents
#-------------------------
# Internal security audits enumerate live hostnames, server filesystem paths,
# seeded account credentials and not-yet-fixed vulnerabilities. They are a
# working document for the maintainer, never something to publish.
AUDIT_*.md
SECURITY_AUDIT*.md

#-------------------------
# Database dumps and archives
#-------------------------
# A dump carries every row the application holds -- student records, user
# rows, bcrypt hashes -- in plaintext.
*.sql
*.sql.gz
*.dump
*.mwb.bak
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

#-------------------------
# Keys, certificates and credential files
#-------------------------
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
.htpasswd

#-------------------------
# Further environment variants
#-------------------------
# `.env` itself is ignored above. These catch the copies people make around a
# deploy, each carrying the same database password and encryption key.
.env.*
!.env.example
*.env
!env

#-------------------------
# Editor, tooling and OS leftovers
#-------------------------
node_modules/
.fleet/
*.swp
*.swo
*.orig
*.rej
